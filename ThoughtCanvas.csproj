<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.7.9</Version>
    <!-- 앱 아이콘 (v0.7.7): exe·작업 표시줄·바로가기. 창 아이콘은 MainWindow.xaml에서 같은 파일을 씁니다 -->
    <ApplicationIcon>Assets\ThoughtCanvas.ico</ApplicationIcon>
    <!-- Velopack 훅을 WPF보다 먼저 처리하기 위해 Program.Main을 진입점으로 씁니다 -->
    <StartupObject>ThoughtCanvas.Program</StartupObject>
    <!-- WPF 메시지 리소스는 한국어만 포함 (다른 언어는 영문 기본값) -->
    <SatelliteResourceLanguages>ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ThoughtCanvas.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>

