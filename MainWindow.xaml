<Window x:Class="ThoughtCanvas.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ThoughtCanvas" Title="ThoughtCanvas · 생각을 펼치는 공간" Width="1440" Height="900" MinWidth="640" MinHeight="600" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Malgun Gothic" FontSize="13" PreviewKeyDown="WindowKeyDown">

 <Grid x:Name="RootGrid">
  <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="Auto"/><RowDefinition x:Name="ToolsRow" Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="StatusRow" Height="34"/></Grid.RowDefinitions>
  <Border x:Name="HeaderBar" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
   <Grid Margin="18,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="BoardPicker" Width="260" DisplayMemberPath="Title" SelectionChanged="BoardSelected"/><Button Content="↻" ToolTip="Drive 목록 새로고침" Click="RefreshBoardsClick"/><Button Content="+ 새 Board" Click="NewBoard"/><Button Content="이름" Click="RenameBoard"/></StackPanel>
    <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SelfTestButton" Content="자동 검증" ToolTip="자동 검증을 별도 프로세스로 실행하고 결과를 보여 줍니다" Click="SelfTestClick"/><Button Content="저장" Click="SaveClick"/><Menu Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"><MenuItem Header="작업"><MenuItem Header="전체 원본 재분석" Click="FullAnalyzeClick"/><MenuItem Header="Export · PDF" Click="ExportClick"/><MenuItem Header="Drive 저장·불러오기" Click="DriveClick"/><MenuItem x:Name="SyncMenu" Header="다른 기기 변경 확인" Click="SyncClick"/><MenuItem Header="등록 기기" Click="DevicesClick"/><MenuItem Header="PC·노트북 공동 편집" Click="LiveClick"/><Separator/><MenuItem Header="연결 설정" Click="SettingsClick"/></MenuItem></Menu><Button x:Name="ThemeButton" Content="Dark mode" Click="ToggleTheme"/><Button Content="?" Click="HelpClick"/></StackPanel>
   </Grid>
  </Border>
  <Border x:Name="ToolsBar" Grid.Row="1" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel x:Name="ToolsDock" Margin="16,8">
    <StackPanel x:Name="ToolsActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ToolbarModeButton" Content="툴바 자동" ToolTip="툴바 배치: 자동(창이 세로로 길면 오른쪽 세로) → 가로 고정 → 세로 고정" Click="ToolbarModeClick"/><Button Content="배치 정돈" Click="LayoutClick"/><Button Content="분류 수정" Click="ClassifyClick"/><Button Content="지금 정리" Background="{DynamicResource AccentBrush}" Foreground="White" Click="AnalyzeClick"/><Button x:Name="PanelToggle" Content="문서 · 검증" Click="TogglePanel"/></StackPanel>
    <WrapPanel x:Name="ToolsWrap"><Button x:Name="PenButton" Content="Pen" Tag="Pen" Click="SelectTool"/><Button x:Name="EraserButton" Content="Eraser" Tag="Eraser" Click="SelectTool"/><Button x:Name="LassoButton" Content="Lasso" Tag="Lasso" Click="SelectTool"/><Button x:Name="TextButton" Content="Text" Tag="Text" Click="SelectTool"/>
     <Border x:Name="SizeControls" BorderThickness="0" Padding="3"><StackPanel x:Name="SizeStack" Orientation="Horizontal"><Border Width="32" Height="32" Margin="4,0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"><Grid><Ellipse x:Name="SizePreview" Width="2.5" Height="2.5" Fill="{DynamicResource TextBrush}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock x:Name="SizePreviewText" Text="가" FontFamily="Malgun Gothic" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><TextBlock x:Name="SizeCaption" Text="크기" VerticalAlignment="Center" Margin="14,0,5,0"/><Slider x:Name="SizeSlider" Focusable="False" Minimum="1" Maximum="12" Value="2.5" Width="95" VerticalAlignment="Center" ValueChanged="ToolSizeChanged"/><TextBlock x:Name="SizeLabel" Text="2.5" Width="45" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel></Border>
     <Button Content="↶" ToolTip="Undo · Ctrl+Z" Click="UndoClick"/><Button Content="↷" ToolTip="Redo · Ctrl+Y" Click="RedoClick"/><Button Content="−" ToolTip="선택 축소" Click="ShrinkClick"/><Button Content="+" ToolTip="선택 확대" Click="GrowClick"/>
    </WrapPanel>
  </DockPanel></Border>
  <Grid x:Name="ContentGrid" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="PanelColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid x:Name="CanvasHost" ClipToBounds="True"><local:BoardSurface x:Name="Surface"/>
    <Border x:Name="Welcome" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,74,0,0" Padding="26" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Text="여기서 생각을 시작하세요." FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Pen으로 적고, 손가락으로 공간을 넓히세요." Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Mouse: 좌클릭 필기 · 우클릭 이동 · Wheel 확대 · 휠클릭 Tool menu" FontSize="11" Margin="0,18,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
    <Button x:Name="FocusButton" Content="UI 숨기기 · F11" Click="ToggleFocus" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" ToolTip="상단 도구와 하단 상태 표시줄을 함께 숨기거나 복원합니다. 필기와 자동 저장은 계속됩니다."/>
    <Canvas x:Name="RadialLayer" IsHitTestVisible="False"/>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="18"><Button Content="−" Click="ZoomOut"/><Button x:Name="ZoomButton" Content="100%" Click="ResetZoom"/><Button Content="+" Click="ZoomIn"/><Button Content="전체 보기" Click="FitClick"/></StackPanel>
   </Grid>
   <Border x:Name="SidePanel" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"><DockPanel Margin="14">
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="생각을 다시 읽는 공간" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="4,4,0,8"/><TextBlock x:Name="AnalysisInfo" Text="아직 AI 정리를 실행하지 않았습니다." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,0,0,10"/></StackPanel>
     <TabControl x:Name="SideTabs">
      <TabItem Header="문서"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Bottom"><Button Content="문서 구조별 원본" Click="DocumentSourcesClick"/><Button Content="문서 수정 이력" Click="DocumentHistoryClick"/><Button Content="읽기 보기" Click="ReadDocumentClick"/><Button Content="주제별 문서" Click="TopicsClick"/><Button Content="Notion에 보내기" Click="NotionClick"/><Button Content="문서 수정 저장" Click="SaveDocument"/><Button x:Name="ProposalButton" Content="AI 갱신 제안 비교" Click="CompareDocument" Visibility="Collapsed"/><TextBlock Text="원본 필기는 유지됩니다. 직접 수정한 문서는 AI가 덮어쓰지 않습니다." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,8"/></StackPanel><TextBox x:Name="DocumentEditor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="14" TextChanged="DocumentChanged"/></DockPanel></TabItem>
      <TabItem Header="검토"><TextBox x:Name="ArchiveEditor" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="8" VerticalContentAlignment="Top"/></TabItem>
      <TabItem x:Name="ReviewTab" Header="검증"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Bottom"><TextBox x:Name="ReviewAnswer" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="검증 답변"/><Button Content="답변 기록 · 확인 완료" Click="ResolveReview"/><Button Content="선택한 원본 보기" Click="ReviewSource"/></StackPanel><ListBox x:Name="ReviewList" SelectionChanged="ReviewSelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" MaxWidth="370" Margin="4,8"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
      <TabItem Header="찾기"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Top"><CheckBox x:Name="SearchAll" Content="모든 Board · Drive 저장본 검색" IsChecked="True" Checked="SearchScopeChanged" Unchecked="SearchScopeChanged"/><Button Content="AI 관련 검색" Click="RelatedClick"/><TextBox x:Name="SearchBox" ToolTip="Keyword 검색" TextChanged="SearchChanged"/><ComboBox x:Name="TopicFilter" SelectionChanged="SearchFilterChanged"/><ComboBox x:Name="CategoryFilter" SelectionChanged="SearchFilterChanged"/></StackPanel><TextBox x:Name="EvidenceBox" DockPanel.Dock="Bottom" Height="180" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/><ListBox x:Name="SearchResults" SelectionChanged="SearchSelected"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" MaxWidth="370" Margin="4,8"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
     </TabControl>
   </DockPanel></Border>
  </Grid>
  <Border x:Name="StatusBar" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><DockPanel Margin="22,0"><TextBlock x:Name="CountsLabel" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBlock x:Name="StatusLabel" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>


